<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MusicCollection.AvaloniaUI.ViewModels"
        xmlns:conv="using:MusicCollection.AvaloniaUI.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MusicCollection.AvaloniaUI.AddAlbumWindow"
        x:DataType="vm:AddAlbumViewModel"
        Title="Добавление диска в коллекцию"
        Width="450" Height="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BitmapAssetValueConverter x:Key="ByteToBitmapConverter"/>
    </Window.Resources>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="Новый альбом" FontSize="20" FontWeight="Bold"/>

            <!-- Выбор артиста -->
            <StackPanel Spacing="5">
                <TextBlock Text="Исполнитель:"/>
                <ComboBox ItemsSource="{Binding Artists}" 
                          SelectedItem="{Binding SelectedArtist}"
                          Text="{Binding ArtistNameText}"
                          IsEditable="True"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Название альбома:"/>
                <TextBox Text="{Binding Title}"/>
            </StackPanel>

            <Grid ColumnDefinitions="*, *">
                <StackPanel Grid.Column="0" Spacing="5" Margin="0,0,10,0">
                    <TextBlock Text="Год выпуска:"/>
                    <NumericUpDown Value="{Binding ReleaseYear}" Minimum="1900" Maximum="2100" FormatString="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="Тип упаковки:"/>
                    <ComboBox ItemsSource="{Binding AllPackagings}" 
                              SelectedItem="{Binding SelectedPackaging}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="5">
                <TextBlock Text="Лейбл:"/>
                <TextBox Text="{Binding Label}"/>
            </StackPanel>

            <!-- Работа с обложкой -->
            <StackPanel Spacing="10">
                <Button Content="Выбрать файл обложки..." 
                        Click="SelectImage_Click" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                
                <Border Height="180" Background="LightGray" CornerRadius="8" ClipToBounds="True">
                    <Image Source="{Binding CoverData, Converter={StaticResource ByteToBitmapConverter}}"
                           Stretch="UniformToFill"/>
                </Border>
            </StackPanel>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Отмена" Click="Cancel_Click" Width="80"/>
                <Button Content="Сохранить" Click="Save_Click" Width="100" Classes="accent"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
  
</Window>
